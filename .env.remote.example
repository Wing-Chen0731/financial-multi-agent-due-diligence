# No-download remote profile. This file is safe to share after filling your own key locally.
# The default uses OpenRouter's free model router for chat. Availability and quotas
# are controlled by the provider; never commit a real API key.
LLM_PROVIDER=openrouter
LLM_MODEL=openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MCP_AUTH_TOKEN=
AGENT_EXECUTION_MODE=fast
LLM_MAX_TOKENS=700

# Default: no local Embedding model and no Embedding API call.
# Set RAG_MODE=vector only after configuring a hosted embedding model below.
KNOWLEDGE_BASE_DIR=data/knowledge_base
RAG_MODE=lexical
RAG_PERSIST_DIR=data/vector_db_remote
RAG_COLLECTION=financial_knowledge_remote
RAG_EMBEDDING_PROVIDER=openai_compatible
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
RAG_EMBEDDING_API_KEY=

# Optional generic aliases for another OpenAI-compatible provider:
# REMOTE_API_KEY=
# REMOTE_BASE_URL=https://api.example.com/v1
