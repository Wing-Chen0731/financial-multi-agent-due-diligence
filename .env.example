# provider: ollama (local open-source model), openrouter, huggingface,
# openai_compatible, or demo
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:1.7b
AGENT_EXECUTION_MODE=fast
LLM_MAX_TOKENS=700
OLLAMA_NUM_CTX=2048
OLLAMA_THINK=false

# Ollama: http://127.0.0.1:11434/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama

# DeepSeek and other OpenAI-compatible providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Hosted open-weight model providers (optional; never commit real keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
REMOTE_API_KEY=
REMOTE_BASE_URL=https://api.openai.com/v1
MCP_AUTH_TOKEN=

# Optional: enables LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=financial-multi-agent

# Local knowledge base
KNOWLEDGE_BASE_DIR=data/knowledge_base
RAG_MODE=auto
RAG_PERSIST_DIR=data/vector_db
RAG_COLLECTION=financial_knowledge
# ollama: qwen3-embedding:0.6b; sentence_transformers: BAAI/bge-small-zh-v1.5;
# openai_compatible: hosted embedding model + RAG_EMBEDDING_BASE_URL/API_KEY
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
